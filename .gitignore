# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# HaVeWa
/storage/
!.env.example
!.env.prod.example
!.env.test.example

# HAVEWA-07A-2: Generated output (Bootstrap-Compile + Runtime-Packaging)
# scripts/dist/   = tsc-Output von build-bootstrap.mjs
# scripts/.runtime/ = gepackagter Prisma-CLI-Tree von package-runtime.mjs
# runtime-state/ = Port-Info, last-shutdown (von start-runtime / start-with-fallback)
scripts/dist/
scripts/.runtime/
runtime-state/

# HAVEWA-07D G1: Runtime Asset Acquisition.
# .runtime-cache/  = lokaler Build-Cache (downloads + extracted) fuer gebundelte Runtimes
# src-tauri/resources/runtime/ = von spaeteren 07D-Phasen abgelegte Runtime-Trees (Bundle-Ziel)
# release/ = spaetere Installer-Outputs (NSIS / WebView2 offline)
.runtime-cache/
!/.runtime-cache/.gitkeep
/src-tauri/resources/runtime/
/release/

# HAVEWA-07D G3: Tauri-Bundle-Artefakte.
# src-tauri/gen/schemas/ = von tauri-build generierte Capability-Schemata
# (bereits in 07C via eslint.config.mjs ignoriert, hier explizit dokumentiert)
/src-tauri/gen/schemas/
