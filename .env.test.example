# Test-DB-Konfiguration (HAVEWA-03). NICHT die Produktions-/Dev-DB verwenden.
# Wird von den Integrationstests über DATABASE_URL_TEST gelesen (Fallback auf
# DATABASE_URL). Passend zu docker-compose.test.yml (Port 5433).
DATABASE_URL_TEST="postgresql://havewa_test:havewa_test@localhost:5433/havewa_test?schema=public"

# Stabiler Schlüssel für deterministische at-rest-Verschlüsselung in Tests.
AUTH_SECRET="test-secret-for-crypto"
